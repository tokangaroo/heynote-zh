/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "appId": "com.heynote.app",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/@vscode/ripgrep/bin/**"
  ],
  //"icon": "public/favicon.ico",
  "directories": {
    "output": "release/${version}",
    "buildResources": "resources"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "mac": {
    "artifactName": "${productName}_${version}_${arch}.${ext}",
    "target": [
      {
        target: 'default',
        arch: [
          'x64',
          'arm64',
          'universal'
        ]
      }
    ],
    "publish": ["github"],
    "category": "public.app-category.productivity",
    "singleArchFiles": "**/node_modules/@vscode/ripgrep/bin/**",
    "x64ArchFiles": "**/node_modules/@vscode/ripgrep/bin/rg",
  },
  "win": {
    // 架构由 CLI 参数控制（--x64 / --arm64），便于构建期间切换 ripgrep 二进制架构
    "target": [
      "nsis",
      "zip"
    ],
    "artifactName": "Heynote_zh_${version}_win_${arch}.${ext}",
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },

  linux: {
    synopsis: "开发者的专属便签本",
    category: "Utility",
    // 架构由 CLI 参数控制（--x64 / --arm64），便于构建期间切换 ripgrep 二进制架构
    target: [
      "AppImage",
      "deb",
    ],
  },
  appImage: {
    artifactName: "Heynote_zh_${version}_linux_${arch}.${ext}",
  },
  deb: {
    artifactName: "Heynote_zh_${version}_linux_${arch}.${ext}",
  },
  snap: {
    artifactName: "${productName}_${version}_${arch}.${ext}",
    publish: ["github"],
  }
}
